---
// Override of Starlight's SiteTitle to add a persistent "Docs" link in the header
// (the splash home page has no sidebar, so this makes the docs obviously reachable).
import Default from "@astrojs/starlight/components/SiteTitle.astro";
---

<div class="weaver-header-left">
  <Default {...Astro.props}><slot /></Default>
  <nav class="weaver-header-nav">
    <a href="/weaver/getting-started/install/">Docs</a>
  </nav>
</div>

<style>
  .weaver-header-left {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    min-width: 0;
  }
  .weaver-header-nav a {
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
  }
  .weaver-header-nav a:hover {
    color: var(--sl-color-accent-high);
  }
</style>
